#!/usr/bin/env bash

set -euo pipefail

"$(dirname "$0")/run-style-checks.sh"

if ! command -v cargo-outdated >/dev/null 2>&1; then
  echo "cargo-outdated is not installed. Install with: cargo install cargo-outdated" >&2
  exit 1
fi

echo "🧾 Running cargo outdated (must report clean)"
cargo outdated --workspace --exit-code 1
