{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "mini-film",
  "version": "11.2.6",
  "identifier": "ch.nakarmamana.minifilm",
  "build": {
    "frontendDist": "assets/app"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "mini-film",
        "width": 1280,
        "height": 900,
        "minWidth": 960,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all"
  }
}
