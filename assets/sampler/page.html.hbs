<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>mini-film sampler</title>
<style>
{{{styles}}}
</style>
</head>
<body style="--columns: {{columns}}">
<main>
<h1>mini-film sampler</h1>
<p class="subtitle">Profiles are grouped by shared name prefixes; indentation shows trie depth. Click a thumbnail to enlarge it, click the enlarged image to compare diffusion, or press and hold either image for the neutral original. The detail panes show focus, highlight, and shadow areas at 100% zoom.</p>
{{{sections}}}
<footer class="footer">
  Generated by <a href="https://github.com/alfanick/mini-film">mini-film</a> {{version}}. Picture by Amadeus Juskowiak.
</footer>
</main>
<div class="overlay" id="overlay" aria-hidden="true">
  <button class="overlay-close" type="button" aria-label="Close">&times;</button>
  <div class="overlay-content">
    <div class="overlay-preview">
      <img id="overlay-image" alt="" role="button" tabindex="0" aria-pressed="false">
    </div>
    <div class="detail-rail" role="group" aria-label="100% detail crops">
      <figure class="detail-crop" data-region="focus" data-center-x="{{focus_x}}" data-center-y="{{focus_y}}">
        <div class="detail-viewport"><img alt="" draggable="false"></div>
        <figcaption>Focus</figcaption>
      </figure>
      <figure class="detail-crop" data-region="highlights" data-center-x="{{highlights_x}}" data-center-y="{{highlights_y}}">
        <div class="detail-viewport"><img alt="" draggable="false"></div>
        <figcaption>Highlights</figcaption>
      </figure>
      <figure class="detail-crop" data-region="shadows" data-center-x="{{shadows_x}}" data-center-y="{{shadows_y}}">
        <div class="detail-viewport"><img alt="" draggable="false"></div>
        <figcaption>Shadows</figcaption>
      </figure>
    </div>
  </div>
  <div class="overlay-caption" id="overlay-caption" aria-live="polite"></div>
</div>
<script>
{{{script}}}
</script>
</body>
</html>
