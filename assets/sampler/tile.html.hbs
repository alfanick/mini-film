<figure class="tile">
<figcaption>
<p class="label">{{label}}</p>
<p class="filename"><span>{{filename}}</span><span class="sidecars"><a href="{{xmp_href}}" download>XMP</a><a href="{{pp3_href}}" download>PP3</a><a href="{{hald_href}}" download>HALD</a></span></p>
</figcaption>
<button class="thumb-button" type="button" data-profile="{{profile_image}}" data-diffusion="{{diffusion_image}}" data-original="{{original_image}}" data-title="{{filename}}" aria-label="Open {{filename}} comparison">
  <img src="{{profile_image}}" alt="{{filename}}" loading="lazy" decoding="async">
</button>
</figure>
