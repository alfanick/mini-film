<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no" />
  <title>mini-film batch gallery · phone</title>
  <style>{{{style}}}</style>
</head>
<body class="batch-gallery batch-gallery-phone">
  <main class="mf-main">
    <header class="mf-top">
      <p class="mf-kicker">{{title}}</p>
      <p class="mf-subtitle">{{date_summary}}</p>
    </header>

    <section class="mf-filter" id="mf-filter" hidden>
      <label class="mf-filter-label" for="mf-tag-filter">Tag</label>
      <input id="mf-tag-filter" class="mf-tag-filter" type="search" list="mf-tag-list" autocomplete="off" placeholder="all tags" />
      <datalist id="mf-tag-list"></datalist>
      <button id="mf-tag-clear" class="mf-tag-clear" type="button">Clear</button>
      <span id="mf-filter-count" class="mf-filter-count"></span>
    </section>

    <section class="mf-grid" style="--columns: {{columns}}">
{{{items}}}
    </section>
  </main>

  <div class="mf-overlay" id="mf-overlay" aria-hidden="true">
    <button class="mf-close" id="mf-overlay-close" type="button" aria-label="Close">×</button>
    <a id="mf-overlay-download" href="" download>Download</a>
    <div id="mf-overlay-meta" aria-live="polite"></div>
    <button class="mf-nav mf-prev" id="mf-overlay-prev" type="button" aria-label="Previous">‹</button>
    <button class="mf-nav mf-next" id="mf-overlay-next" type="button" aria-label="Next">›</button>
    <img id="mf-overlay-image" src="" alt="" />
    <p id="mf-overlay-caption"></p>
    <p id="mf-overlay-note"></p>
  </div>

  <script>{{{script}}}</script>
</body>
</html>
