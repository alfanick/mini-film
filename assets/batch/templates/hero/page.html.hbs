<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>mini-film batch gallery · hero</title>
  <style>{{{style}}}</style>
</head>
<body class="batch-gallery batch-gallery-hero">
  <div class="mf-shell">
    <header class="mf-header">
      <p class="mf-kicker">mini-film batch gallery</p>
      <h1>Hero Portfolio</h1>
      <p class="mf-subtitle">Profile: <strong>{{profile}}</strong></p>
      <p class="mf-subtitle output">Output: {{output}}</p>
    </header>

    <main>
      <section class="mf-grid mf-hero-grid" style="--columns: {{columns}}">
{{{items}}}
      </section>
    </main>
  </div>

  <div class="mf-overlay" id="mf-overlay" aria-hidden="true">
    <button class="mf-close" id="mf-overlay-close" type="button" aria-label="Close">×</button>
    <a id="mf-overlay-download" href="" download>Download</a>
    <div id="mf-overlay-meta" aria-live="polite"></div>
    <button class="mf-nav mf-prev" id="mf-overlay-prev" type="button" aria-label="Previous">‹</button>
    <button class="mf-nav mf-next" id="mf-overlay-next" type="button" aria-label="Next">›</button>
    <img id="mf-overlay-image" src="" alt="" />
    <p id="mf-overlay-caption"></p>
  </div>

  <script>{{{script}}}</script>
</body>
</html>
