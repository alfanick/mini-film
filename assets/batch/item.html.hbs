<button class="mf-thumb" type="button" data-full="{{full}}" data-caption="{{caption}}" data-focal="{{focal}}" data-aperture="{{aperture}}" data-shutter="{{shutter}}" data-iso="{{iso}}" data-camera="{{camera}}">
  <img src="{{thumb}}" alt="{{caption}}" loading="lazy" decoding="async" />
  <span class="mf-thumb-caption">{{caption}}</span>
</button>
